{
  "name": "finances",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "description": "Suivi des investissements financiers — multi-plateforme (Android, Web, Windows)",
  "author": "Patrimoine",
  "dependencies": {
    "@expo/ui": "~58.0.28",
    "@noble/hashes": "^2.2.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-picker/picker": "2.11.4",
    "expo": "^58.0.0",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.16",
    "expo-device": "~58.0.5",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.12",
    "expo-glass-effect": "~58.0.5",
    "expo-image": "~58.0.18",
    "expo-linking": "~58.0.17",
    "expo-local-authentication": "~58.0.3",
    "expo-localization": "~58.0.5",
    "expo-router": "~58.0.31",
    "expo-secure-store": "~58.0.3",
    "expo-sharing": "~58.0.23",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "expo-symbols": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "expo-web-browser": "~58.0.8",
    "i18next": "^26.4.0",
    "js-base64": "^3.8.1",
    "jsrsasign": "^11.1.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "^17.0.12",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/jsrsasign": "^10.5.15",
    "@types/react": "~19.2.2",
    "@vitest/coverage-v8": "^5.0.1",
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3",
    "typescript": "~6.0.3",
    "vitest": "^5.0.1"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "build:web": "expo export --platform web",
    "electron": "electron electron/main.js",
    "windows:dev": "expo export --platform web && electron electron/main.js",
    "windows:build": "expo export --platform web && electron-builder --win"
  },
  "private": true,
  "build": {
    "appId": "fr.perso.patrimoine",
    "productName": "Finances",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraMetadata": {
      "main": "electron/main.js"
    },
    "win": {
      "target": "nsis"
    }
  }
}
